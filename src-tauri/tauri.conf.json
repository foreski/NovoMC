{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovoMC",
  "version": "0.1.6",
  "identifier": "com.novomc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NovoMC",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NovoMC",
    "resources": {
      "resources/novomc-client.jar": "resources/novomc-client.jar",
      "../novomc.config.json": "novomc.config.json"
    },
    "shortDescription": "NovoMC Minecraft launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNzA4N0YwNUYwNTg3RjAKUldUd2h3VmY4SWR3YjVrdm1JMzhOWVpIaDEyZFVNMFhXZEg4QjdpcUZtUndyRWZ3SG15SFNURjcK",
      "endpoints": [
        "https://github.com/foreski/NovoMC/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
